FROM gradle:8.14.3-jdk17 AS development

WORKDIR /workspace

COPY infra/dev-entrypoint.sh /usr/local/bin/dev-entrypoint
COPY . .

ENV HEALTHSYS_BUILD_DIR=/tmp/healthsys-build

EXPOSE 8085

ENTRYPOINT ["bash", "/usr/local/bin/dev-entrypoint"]
CMD ["notification-service"]

FROM gradle:8.14.3-jdk17 AS build

WORKDIR /workspace

COPY . .

RUN --mount=type=cache,id=healthsys-gradle-build,target=/home/gradle/.gradle,sharing=locked \
    gradle :services:notification-service:bootJar --no-daemon --max-workers=2

FROM eclipse-temurin:17-jre-alpine AS production

WORKDIR /app

COPY --from=build /workspace/services/notification-service/build/libs/*.jar app.jar

EXPOSE 8085

ENTRYPOINT ["java", "-jar", "app.jar"]
